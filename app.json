{
  "expo": {
    "name": "Hexis",
    "slug": "hexis",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "hexis",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abhinand.hexis",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "./plugins/withLocalNotificationsOnly",
      "./plugins/withUserScriptSandboxingDisabled",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
